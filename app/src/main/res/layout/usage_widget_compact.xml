<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="11dp"
    android:paddingEnd="5dp">

    <LinearLayout
        android:id="@+id/widget_compact_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="1dp">

        <TextView
            android:id="@+id/widget_compact_label"
            style="@style/WidgetLimitLabel"
            android:layout_height="14dp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeMinTextSize="7dp"
            android:autoSizeStepGranularity="1dp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:text="@string/widget_compact_placeholder"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_compact_value"
            style="@style/WidgetPercent"
            android:layout_height="22dp"
            android:layout_marginTop="0dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="11dp"
            android:autoSizeStepGranularity="1dp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:textColor="@color/mint"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:id="@+id/widget_compact_track"
                style="@style/WidgetBarLayer"
                android:src="@drawable/widget_bar_track"
                android:tint="@color/track" />

            <ImageView
                android:id="@+id/widget_compact_bar"
                style="@style/WidgetBarLayer"
                android:src="@drawable/widget_bar_fill"
                android:tint="@color/mint" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/refresh_usage"
        android:scaleType="center"
        android:src="@drawable/ic_refresh" />
</LinearLayout>
